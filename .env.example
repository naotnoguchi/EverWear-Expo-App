# Development Configuration
# Using Supabase database
EXPO_PUBLIC_USE_MOCK_DATA=true
EXPO_PUBLIC_SUPABASE_URL=your-supabase-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Revenue Cat
EXPO_PUBLIC_REVENUE_CAT_API_KEY_IOS=your-revenuecat-api-key-ios
EXPO_PUBLIC_REVENUE_CAT_API_KEY_ANDROID=your-revenuecat-api-key-android

# App Info
EXPO_PUBLIC_APP_BUNDLE_ID=com.naotnoguchi.everwear

# Product IDs
EXPO_PUBLIC_PREMIUM_MONTHLY_PRODUCT_ID=everwear_premium_monthly_v1
EXPO_PUBLIC_PREMIUM_YEARLY_PRODUCT_ID=everwear_premium_annual_v1

# Supabase Edge Functions (Webhook用)
REVENUE_CAT_WEBHOOK_SECRET=your_webhook_secret