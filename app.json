{
  "expo": {
    "name": "ClothesManagerApp",
    "slug": "ClothesManagerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clothesmanagerapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:jxfihlecaqzowheeomxt.supabase.co"
      ],
      "bundleIdentifier": "com.naotnoguchi.everwear",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jxfihlecaqzowheeomxt.supabase.co",
              "pathPrefix": "/auth/v1/callback"
            },
            {
              "scheme": "clothesmanagerapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.naotnoguchi.everwear"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcf5e6cc-aa85-4c36-8992-8c50b97d87b4"
      }
    },
    "owner": "naotnoguchi"
  }
}
